# KisanMausam server environment
# Put your real keys here. Never commit this file.

# Existing Google Weather API key used by the weather backend
GOOGLE_WEATHER_API_KEY=PASTE_YOUR_GOOGLE_WEATHER_API_KEY_HERE

# Groq API key - only needed for crop-specific AI advice
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE

# Groq model with strict Structured Outputs support
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=30
GROQ_CACHE_SECONDS=600
